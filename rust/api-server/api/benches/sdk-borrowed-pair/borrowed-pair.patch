+    #[test]
+    fn live_pair_borrows_original_rows_and_only_matches_on_request() {
+        let mut update = TableUpdate::default();
+        update.deletes.push(row(7, 10));
+        update.inserts.push(row(7, 20));
+        let old = &update.deletes[0].row;
+        let new = &update.inserts[0].row;
+        let diff = TableAppliedDiff::from_raw(&update);
+        assert!(std::ptr::eq(diff.deletes().next().unwrap(), old));
+        assert!(std::ptr::eq(diff.inserts().next().unwrap(), new));
+        assert_eq!(diff.updates().count(), 0);
+        let matched = diff.with_updates_by_pk(|r| &r.id);
+        let matched = matched.with_updates_by_pk::<u32>(|_| panic!("already paired"));
+        assert!(matched.has_changes());
+        assert!(matched.initial_rows().is_none());
+        assert_eq!((matched.deletes().count(), matched.inserts().count()), (0, 0));
+        let mut updates = matched.updates();
+        let (a, b) = updates.next().unwrap();
+        assert!(std::ptr::eq(a, old) && std::ptr::eq(b, new));
+        assert!(updates.next().is_none());
+    }
+
+    #[test]
+    fn initial_diff_keeps_its_source_even_when_rows_pair() {
+        let mut update = TableUpdate::default();
+        update.append(TableUpdate::default());
+        update.deletes.push(row(7, 10));
+        update.inserts.push(row(7, 20));
+        update.mark_initial();
+        let diff = TableAppliedDiff::from_raw(&update).with_updates_by_pk(|r| &r.id);
+        assert!(std::ptr::eq(diff.initial_rows().unwrap(), &update.inserts));
+        assert!(diff.updates().eq([(&update.deletes[0].row, &update.inserts[0].row)]));
+    }
